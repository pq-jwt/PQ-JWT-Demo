{
  "name": "pq-jwttest",
  "version": "1.0.0",
  "description": "PQ-JWT demo app — JS + TypeScript integration with @pq-jwt/core 1.0.4",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev:api": "node --watch-path=src src/server.js",
    "dev:web": "node scripts/frontend-dev.mjs",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "test:aud": "node scripts/test-audience.mjs",
    "test:api": "node scripts/test-all-apis.mjs",
    "test:core": "node scripts/test-pq-jwt-core.mjs",
    "test:hybrid": "node scripts/test-pq-jwt-hybrid.mjs",
    "test:jwt-api": "node scripts/test-jwt-api.mjs",
    "test:cookies": "node scripts/test-cookies.mjs",
    "test:ts": "cd typescript-test && npm install && npm test",
    "test": "npm run test:core && npm run test:hybrid && npm run test:aud && npm run test:cookies && npm run test:api && npm run test:jwt-api && npm run test:ts",
    "keys:generate": "node scripts/one-time-setup.mjs",
    "keys:example": "node scripts/sign-verify-env-example.mjs",
    "keys:hybrid-example": "node scripts/sign-verify-env-hybrid-example.mjs",
    "test:user": "node scripts/test-user-apis.mjs scripts/.test-token",
    "express:start": "cd pq-jwt-express-demo && npm start",
    "express:test": "cd pq-jwt-express-demo && npm test",
    "jose:start": "cd pq-jose-demo && npm install && npm start",
    "jose:test": "cd pq-jose-demo && npm install && npm test"
  },
  "keywords": [
    "jwt",
    "post-quantum",
    "crud"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruhil6789/PQ-JWT-Demo.git"
  },
  "homepage": "https://www.npmjs.com/package/@pq-jwt/core",
  "bugs": {
    "url": "https://github.com/ruhil6789/PQ-JWT-Demo/issues"
  },
  "dependencies": {
    "@pq-jose/jose": "^0.0.1",
    "@pq-jwt/core": "^1.0.4",
    "@pq-jwt/express": "^0.0.1",
    "@pq-jwt/hybrid": "^0.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "http-proxy-middleware": "^3.0.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
